<!--新增梦境页面-->
<view class="container">
  <view class="form-section">
    <view class="section-title">
      <text class="title-icon">📅</text>
      <text>梦境日期</text>
    </view>
    <picker mode="date" value="{{dreamDate}}" bindchange="onDateChange">
      <view class="input-field">
        <text class="field-value">{{dreamDate || '选择日期'}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <view class="form-section">
    <view class="section-title">
      <text class="title-icon">⏰</text>
      <text>梦境时间（选填）</text>
    </view>
    <picker mode="time" value="{{dreamTime}}" bindchange="onTimeChange">
      <view class="input-field">
        <text class="field-value">{{dreamTime || '选择时间'}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <view class="form-section">
    <view class="section-title">
      <text class="title-icon">✨</text>
      <text>梦境内容</text>
    </view>
    <textarea 
      class="textarea-field"
      placeholder="记录你梦到{{petName}}的梦境..."
      value="{{dreamContent}}"
      bindinput="onContentInput"
      maxlength="1000"
      show-confirm-bar="{{false}}"
    ></textarea>
    <view class="char-count">{{dreamContent.length}}/1000</view>
  </view>

  <view class="form-section">
    <view class="section-title">
      <text class="title-icon">💭</text>
      <text>情感类型</text>
    </view>
    <view class="emotion-grid">
      <view 
        wx:for="{{emotions}}" 
        wx:key="value"
        class="emotion-btn {{emotionType === item.value ? 'active' : ''}}"
        bindtap="selectEmotion"
        data-value="{{item.value}}"
      >
        <text class="emotion-icon">{{item.icon}}</text>
        <text class="emotion-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">
      <text class="title-icon">🏷️</text>
      <text>添加标签（选填）</text>
    </view>
    <view class="tags-input">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-item">
        <text>{{item}}</text>
        <text class="remove-tag" bindtap="removeTag" data-index="{{index}}">×</text>
      </view>
      <input 
        class="tag-input"
        placeholder="输入标签后回车"
        value="{{tagInput}}"
        bindinput="onTagInput"
        bindconfirm="addTag"
      />
    </view>
    <view class="suggested-tags">
      <text class="suggest-label">推荐：</text>
      <text 
        wx:for="{{suggestedTags}}" 
        wx:key="*this"
        class="suggest-tag"
        bindtap="addSuggestedTag"
        data-tag="{{item}}"
      >
        {{item}}
      </text>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">
      <text class="title-icon">🔒</text>
      <text>隐私设置</text>
    </view>
    <view class="switch-item">
      <text>设为私密（仅自己可见）</text>
      <switch checked="{{isPrivate}}" bindchange="onPrivateChange"/>
    </view>
  </view>

  <view class="ai-notice">
    <text class="notice-icon">🤖</text>
    <text class="notice-text">AI将自动分析你的梦境并生成解读</text>
  </view>

  <view class="button-group">
    <button class="cancel-btn" bindtap="goBack">取消</button>
    <button class="submit-btn" bindtap="submitDream" loading="{{submitting}}">
      保存梦境
    </button>
  </view>
</view>

