/* pages/add-dream/add-dream.wxss */
page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #434190 100%);
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  padding-bottom: 200rpx;
}

.form-section {
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx);
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 32rpx;
}

.input-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.field-value {
  flex: 1;
}

.arrow {
  color: rgba(255, 255, 255, 0.5);
}

.textarea-field {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 10rpx;
}

.emotion-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
}

.emotion-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 25rpx 10rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  transition: all 0.3s;
}

.emotion-btn.active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(1.05);
}

.emotion-icon {
  font-size: 40rpx;
}

.emotion-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.tags-input {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  min-height: 80rpx;
  align-items: center;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 15rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.remove-tag {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tag-input {
  flex: 1;
  min-width: 150rpx;
  height: 60rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.suggested-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 15rpx;
  align-items: center;
}

.suggest-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.suggest-tag {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.ai-notice {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 25rpx;
  background: rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.notice-icon {
  font-size: 36rpx;
}

.notice-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

.button-group {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(102, 126, 234, 0.95) 0%, rgba(102, 126, 234, 0.8) 100%);
  backdrop-filter: blur(20rpx);
}

.cancel-btn, .submit-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.cancel-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.submit-btn {
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  color: #ffffff;
}

