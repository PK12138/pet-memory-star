/* 整体容器 */
.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);
}

/* 顶部导航栏 */
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
}

.header-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-container {
  position: relative;
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.pet-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at top, #2c3e50 0%, #1a252f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.avatar-emoji {
  font-size: 45rpx;
}

.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 20rpx;
  height: 20rpx;
  background: #2ecc71;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(46, 204, 113, 0.4);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.1);
  }
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.online-status {
  font-size: 24rpx;
  color: #27ae60;
}

.btn-clear {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 50%;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.btn-clear .icon {
  font-size: 28rpx;
}

/* 消息列表区域 */
.messages-container {
  flex: 1;
  padding: 30rpx;
  overflow-y: scroll;
}

.message-wrapper {
  margin-bottom: 30rpx;
}

.message {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-ai {
  justify-content: flex-start;
}

.message-user {
  justify-content: flex-end;
}

.message-avatar-wrapper {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
}

.message-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.message-avatar-placeholder {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at top, #2c3e50 0%, #1a252f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.user-avatar-placeholder {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(240, 147, 251, 0.3);
}

.avatar-emoji-small {
  font-size: 35rpx;
}

.message-content {
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
}

.message-bubble {
  padding: 20rpx 25rpx;
  border-radius: 20rpx;
  word-wrap: break-word;
  white-space: pre-wrap;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.message-bubble-ai {
  background: rgba(255, 255, 255, 0.95);
  border-bottom-left-radius: 5rpx;
}

.message-bubble-user {
  background: radial-gradient(ellipse at top, #2c3e50 0%, #1a252f 100%);
  border-bottom-right-radius: 5rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2c3e50;
}

.message-bubble-user .message-text {
  color: #fff;
}

/* 输入中动画 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 10rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #667eea;
  animation: typing 1.4s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

/* 输入栏 */
.input-container {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.1);
}

.input-wrapper {
  flex: 1;
  position: relative;
  background: #f5f5f5;
  border-radius: 25rpx;
  padding: 15rpx 25rpx;
  min-height: 80rpx;
  display: flex;
  flex-direction: column;
}

.message-input {
  width: 100%;
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.5;
  max-height: 200rpx;
}

.char-count {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  margin-top: 5rpx;
}

.btn-send {
  width: 120rpx;
  height: 80rpx;
  background: radial-gradient(ellipse at top, #2c3e50 0%, #1a252f 100%);
  border-radius: 25rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.btn-send:disabled {
  background: #e0e0e0;
  box-shadow: none;
}

.send-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.btn-send:disabled .send-icon {
  color: #999;
}

.btn-send:active:not(:disabled) {
  transform: scale(0.95);
}
