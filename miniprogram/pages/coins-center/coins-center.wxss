.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0e27 0%, #1a1447 50%, #2d1b69 100%);
  padding: 40rpx 30rpx;
}

/* 余额卡片 */
.balance-card {
  position: relative;
  background: linear-gradient(135deg, rgba(138, 43, 226, 0.2), rgba(75, 0, 130, 0.2));
  backdrop-filter: blur(20px);
  border: 2px solid rgba(138, 43, 226, 0.3);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.balance-decoration {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 80rpx;
  opacity: 0.1;
}

.balance-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.balance-icon {
  font-size: 40rpx;
}

.balance-amount {
  font-size: 88rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(138, 43, 226, 0.4);
  margin-bottom: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.balance-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 签到区域 */
.sign-in-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.section-more {
  margin-left: auto;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.sign-in-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 30rpx;
}

.sign-in-left {
  flex: 1;
}

.sign-in-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.sign-in-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 12rpx;
}

.sign-in-days {
  font-size: 26rpx;
  color: #ffd700;
}

.days-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffd700;
}

.sign-in-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #8a2be2, #9370db);
  padding: 20rpx 32rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(138, 43, 226, 0.3);
}

.sign-in-btn.signed {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: none;
}

.btn-icon {
  font-size: 28rpx;
  color: #fff;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

/* 获取星币 */
.earn-section {
  margin-bottom: 40rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  transition: all 0.3s;
}

.task-item.ad-task {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(255, 165, 0, 0.1));
  border-color: rgba(255, 215, 0, 0.3);
}

.task-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.task-icon {
  font-size: 48rpx;
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

.task-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.task-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.2);
  font-weight: 300;
}

.task-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #ffd700, #ffb700);
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 215, 0, 0.3);
}

.task-btn .btn-icon {
  color: #000;
}

.task-btn .btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #000;
}

/* 消费星币 */
.spend-section {
  margin-bottom: 40rpx;
}

.shop-preview {
  display: flex;
  gap: 20rpx;
}

.shop-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 32rpx;
  transition: all 0.3s;
}

.shop-icon {
  font-size: 64rpx;
}

.shop-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.shop-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

.shop-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffd700;
}

/* 交易记录 */
.transactions-section {
  margin-bottom: 40rpx;
}

.transaction-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.transaction-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.transaction-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.transaction-icon {
  font-size: 40rpx;
}

.transaction-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.transaction-desc {
  font-size: 28rpx;
  color: #fff;
}

.transaction-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.transaction-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.transaction-amount.income {
  color: #4ade80;
}

.transaction-amount.expense {
  color: #f87171;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}


