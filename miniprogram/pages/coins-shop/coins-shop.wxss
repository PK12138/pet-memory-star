.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0e27 0%, #1a1447 50%, #2d1b69 100%);
  padding-bottom: 40rpx;
}

/* 余额栏 */
.balance-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(138, 43, 226, 0.2), rgba(75, 0, 130, 0.2));
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 32rpx 30rpx;
}

.balance-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.balance-icon {
  font-size: 40rpx;
}

.balance-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.balance-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(138, 43, 226, 0.4);
}

.refresh-btn {
  padding: 12rpx;
}

.refresh-icon {
  font-size: 32rpx;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.3));
  border-color: rgba(138, 43, 226, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(138, 43, 226, 0.3);
}

.tab-icon {
  font-size: 40rpx;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

/* 商品区域 */
.products-section {
  padding: 0 30rpx;
}

/* 会员卡片 */
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.product-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #ffd700, #ffb700);
  color: #000;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.product-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 30rpx;
}

.product-features {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feature-dot {
  color: #8a2be2;
  font-size: 24rpx;
}

.feature-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.product-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd700;
}

.price-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.buy-btn {
  background: linear-gradient(135deg, #8a2be2, #9370db);
  padding: 20rpx 48rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(138, 43, 226, 0.4);
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

/* 功能卡片 */
.feature-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.feature-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.feature-icon {
  font-size: 56rpx;
}

.feature-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

.feature-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.feature-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.feature-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffd700;
}

.feature-buy-btn {
  background: linear-gradient(135deg, #8a2be2, #9370db);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

/* 购买须知 */
.notice-section {
  margin: 40rpx 30rpx 0;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
}

.notice-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.notice-icon {
  font-size: 32rpx;
}

.notice-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.notice-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
}


