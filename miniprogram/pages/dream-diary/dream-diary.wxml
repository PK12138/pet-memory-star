<!--梦境日记页面-->
<view class="container">
  <!-- 顶部背景 -->
  <view class="header-bg">
    <view class="moon-icon">🌙</view>
    <view class="stars">
      <text class="star">✨</text>
      <text class="star">⭐</text>
      <text class="star">💫</text>
    </view>
  </view>

  <!-- 标题区 -->
  <view class="page-header">
    <text class="page-title">梦境日记</text>
    <text class="page-subtitle">记录与{{petName}}的梦中重逢</text>
  </view>

  <!-- 统计信息卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{stats.total_dreams || 0}}</text>
      <text class="stat-label">梦境次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.favorite_count || 0}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.last_dream_date || '-'}}</text>
      <text class="stat-label">最近梦到</text>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'list' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="list"
    >
      <text>📔 梦境列表</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'calendar' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="calendar"
    >
      <text>📅 梦境月历</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'stats' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="stats"
    >
      <text>📊 情感统计</text>
    </view>
  </view>

  <!-- 梦境列表视图 -->
  <view wx:if="{{activeTab === 'list'}}" class="content-area">
    <scroll-view 
      scroll-y 
      class="dream-list"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
    >
      <view wx:if="{{dreams.length === 0}}" class="empty-state">
        <text class="empty-icon">🌙</text>
        <text class="empty-text">还没有记录梦境</text>
        <text class="empty-tip">点击下方按钮记录第一个梦境吧</text>
      </view>

      <view 
        wx:for="{{dreams}}" 
        wx:key="id" 
        class="dream-card"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <view class="dream-header">
          <view class="dream-date">
            <text class="date-main">{{item.dream_date}}</text>
            <text wx:if="{{item.dream_time}}" class="date-time">{{item.dream_time}}</text>
          </view>
          <view class="emotion-badge {{item.emotion_type}}">
            <text>{{getEmotionIcon(item.emotion_type)}} {{item.emotion_type}}</text>
          </view>
        </view>

        <view class="dream-content">
          <text class="dream-text">{{item.dream_content}}</text>
        </view>

        <view wx:if="{{item.tags}}" class="dream-tags">
          <text 
            wx:for="{{item.tags.split(',')}}" 
            wx:for-item="tag" 
            wx:key="*this"
            class="tag"
          >
            #{{tag}}
          </text>
        </view>

        <view class="dream-footer">
          <view class="footer-left">
            <text class="mood-score">情感强度: {{item.mood_score}}/10</text>
          </view>
          <view class="footer-right">
            <text 
              class="favorite-icon {{item.is_favorite ? 'active' : ''}}"
              catchtap="toggleFavorite"
              data-id="{{item.id}}"
              data-favorite="{{item.is_favorite}}"
            >
              {{item.is_favorite ? '⭐' : '☆'}}
            </text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 月历视图 -->
  <view wx:if="{{activeTab === 'calendar'}}" class="content-area">
    <view class="calendar-header">
      <text class="calendar-nav" bindtap="prevMonth">◀</text>
      <text class="calendar-title">{{currentYear}}年{{currentMonth}}月</text>
      <text class="calendar-nav" bindtap="nextMonth">▶</text>
    </view>

    <view class="calendar-grid">
      <view class="calendar-weekday" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">
        {{item}}
      </view>
      
      <view 
        wx:for="{{calendarDays}}" 
        wx:key="index"
        class="calendar-day {{item.hasDream ? 'has-dream' : ''}} {{item.isToday ? 'today' : ''}} {{item.isOtherMonth ? 'other-month' : ''}}"
      >
        <text class="day-number">{{item.day}}</text>
        <view wx:if="{{item.hasDream}}" class="dream-dot"></view>
      </view>
    </view>

    <view class="calendar-legend">
      <view class="legend-item">
        <view class="legend-dot has-dream"></view>
        <text>有梦境记录</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot today"></view>
        <text>今天</text>
      </view>
    </view>
  </view>

  <!-- 统计视图 -->
  <view wx:if="{{activeTab === 'stats'}}" class="content-area">
    <view class="stats-section">
      <text class="section-title">情感分布</text>
      <view class="emotion-chart">
        <view 
          wx:for="{{emotionStats}}" 
          wx:key="emotion"
          class="emotion-bar-item"
        >
          <view class="emotion-label">
            <text class="emotion-icon">{{item.icon}}</text>
            <text class="emotion-name">{{item.emotion}}</text>
          </view>
          <view class="emotion-bar-container">
            <view 
              class="emotion-bar {{item.emotion}}" 
              style="width: {{item.percentage}}%"
            ></view>
          </view>
          <text class="emotion-count">{{item.count}}次</text>
        </view>
      </view>
    </view>

    <view class="stats-section">
      <text class="section-title">梦境频率</text>
      <view class="frequency-info">
        <view class="info-item">
          <text class="info-label">平均频率</text>
          <text class="info-value">每月{{avgFrequency}}次</text>
        </view>
        <view class="info-item">
          <text class="info-label">最长间隔</text>
          <text class="info-value">{{maxGap}}天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 新增按钮 -->
  <view class="add-button" bindtap="addDream">
    <text class="add-icon">+</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>

