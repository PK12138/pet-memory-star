<view class="container">
  <view class="form-container">
    <view class="header">
      <text class="title">找回密码</text>
      <text class="subtitle">请输入注册时使用的邮箱</text>
    </view>

    <!-- 步骤1：输入邮箱 -->
    <view wx:if="{{step === 1}}" class="form-section">
      <view class="input-group">
        <text class="label">邮箱地址 <text class="required">*</text></text>
        <input
          class="input"
          type="text"
          placeholder="请输入注册邮箱"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>

      <button class="btn btn-primary" bindtap="sendCode" disabled="{{!email || sending}}">
        {{sending ? '发送中...' : '发送验证码'}}
      </button>
    </view>

    <!-- 步骤2：输入验证码和新密码 -->
    <view wx:if="{{step === 2}}" class="form-section">
      <view class="input-group">
        <text class="label">验证码 <text class="required">*</text></text>
        <view class="code-input-wrapper">
          <input
            class="input"
            type="text"
            placeholder="请输入6位验证码"
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
          <button class="btn-resend" bindtap="resendCode" disabled="{{countdown > 0}}">
            {{countdown > 0 ? countdown + 's' : '重新发送'}}
          </button>
        </view>
      </view>

      <view class="input-group">
        <text class="label">新密码 <text class="required">*</text></text>
        <input
          class="input"
          type="password"
          placeholder="请输入新密码（至少6位）"
          value="{{newPassword}}"
          bindinput="onPasswordInput"
        />
      </view>

      <view class="input-group">
        <text class="label">确认密码 <text class="required">*</text></text>
        <input
          class="input"
          type="password"
          placeholder="请再次输入新密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>

      <button class="btn btn-primary" bindtap="resetPassword" disabled="{{!canReset || resetting}}">
        {{resetting ? '重置中...' : '重置密码'}}
      </button>

      <button class="btn btn-link" bindtap="backToStep1">
        返回上一步
      </button>
    </view>

    <!-- 返回登录 -->
    <view class="footer">
      <text class="link" bindtap="backToLogin">返回登录</text>
    </view>
  </view>
</view>



