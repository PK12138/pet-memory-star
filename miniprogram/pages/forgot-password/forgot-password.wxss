.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-container {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.form-section {
  width: 100%;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #f56c6c;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  box-sizing: border-box;
}

.input:focus {
  background: #fff;
  border-color: #667eea;
}

.code-input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input-wrapper .input {
  flex: 1;
}

.btn-resend {
  height: 88rpx;
  padding: 0 30rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #667eea;
  border: none;
  white-space: nowrap;
}

.btn-resend:disabled {
  color: #999;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  margin-top: 40rpx;
}

.btn-primary:disabled {
  opacity: 0.6;
}

.btn-link {
  background: transparent;
  color: #667eea;
  margin-top: 20rpx;
  font-size: 28rpx;
}

.footer {
  margin-top: 40rpx;
  text-align: center;
}

.link {
  color: #667eea;
  font-size: 28rpx;
  text-decoration: underline;
}



