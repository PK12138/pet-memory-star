<!--pages/index/index.wxml-->
<view class="starry-container">
  <!-- 星空画布 -->
  <canvas 
    type="2d" 
    id="starCanvas" 
    class="star-canvas"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  ></canvas>

  <!-- 欢迎文字 (首次进入或未登录时显示) -->
  <view class="welcome-overlay" wx:if="{{showWelcome}}">
    <view class="welcome-content" animation="{{welcomeAnimation}}">
      <text class="welcome-icon">🌟</text>
      <text class="welcome-title">爪迹星·云纪念馆</text>
      <text class="welcome-subtitle">每一颗星星，都是一个永恒的灵魂</text>
      <text class="welcome-hint">{{ userInfo ? '滑动旋转星球，探索每一颗星星' : '登录后，创建属于你的星星' }}</text>
    </view>
  </view>

  <!-- 顶部信息栏 -->
  <view class="top-bar">
    <view class="top-left">
      <text class="app-name">爪迹星</text>
      <text class="star-count" wx:if="{{userInfo}}">{{myStarCount}} 颗星星</text>
    </view>
    <view class="top-right" wx:if="{{userInfo}}">
      <text class="user-name">{{userInfo.email}}</text>
      <view class="feedback-float-btn" bindtap="goToFeedback">
        <text class="feedback-emoji">💡</text>
      </view>
    </view>
  </view>

  <!-- 滑动提示（仅首次显示） -->
  <view class="swipe-hint" wx:if="{{!showWelcome && totalStars > 0}}">
    <text class="hint-icon">👆</text>
    <text class="hint-text">滑动旋转星球</text>
  </view>

  <!-- 底部悬浮操作球 -->
  <view class="float-menu">
    <view class="float-menu-item" bindtap="startCreateStar">
      <view class="menu-icon create-icon">✨</view>
      <text class="menu-label">创建星星</text>
    </view>
    
    <view class="float-menu-item" bindtap="goToProfile">
      <view class="menu-icon profile-icon">👑</view>
      <text class="menu-label">我的</text>
    </view>
  </view>

  <!-- 星星详情弹窗 -->
  <view class="star-detail-modal {{selectedStar ? 'show' : ''}}" bindtap="closeStarDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="star-header">
        <view class="star-avatar-wrapper">
          <image 
            wx:if="{{selectedStar.photo_url && selectedStar.photo_url != 'null'}}"
            class="star-avatar" 
            src="{{selectedStar.photo_url}}" 
            mode="aspectFill"
            binderror="onImageError"
            show-menu-by-longpress="{{false}}"
          />
          <view wx:else class="star-avatar-placeholder">
            <text class="placeholder-emoji">🐾</text>
          </view>
        </view>
        <view class="star-info">
          <text class="star-name">{{selectedStar.pet_name}}</text>
          <text class="star-dates">{{selectedStar.memorial_date || '永远怀念'}}</text>
        </view>
        <view class="close-btn" catchtap="closeStarDetail">✕</view>
      </view>
      
      <view class="star-description">
        {{selectedStar.story || '一只可爱的宠物'}}
      </view>
      
      <view class="star-actions">
        <button class="action-btn primary" catchtap="viewMemorial" data-id="{{selectedStar.id}}">
          <text class="btn-icon">🏠</text>
          <text>进入纪念馆</text>
        </button>
        <button class="action-btn" catchtap="chatWithPet" data-id="{{selectedStar.id}}">
          <text class="btn-icon">💬</text>
          <text>开始对话</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载星空...</text>
  </view>
</view>
