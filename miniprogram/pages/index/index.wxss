/* pages/index/index.wxss */

page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  min-height: 100vh;
}

.container {
  max-width: 100%;
  margin: 0;
  padding: 20rpx;
  position: relative;
  z-index: 1;
}

/* Glassmorphism 卡片样式 - 与网页版一致 */
.glass-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  box-shadow: 
    0 16rpx 64rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
  padding: 80rpx 40rpx;
  margin-bottom: 30rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transition: left 0.5s;
}

.glass-card:active::before {
  left: 100%;
}

/* 主标题区域 - 优化版 */
.main-title {
  text-align: center;
  margin-bottom: 45rpx;
  padding: 10rpx 0;
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 25rpx;
  display: block;
  animation: float 3s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-15rpx) rotate(5deg); }
}

.logo-title {
  font-size: 52rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 20rpx;
  display: block;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  display: block;
  line-height: 1.6;
  font-weight: 400;
}

/* 认证按钮区域 */
.auth-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.auth-btn {
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s ease;
  min-width: 120rpx;
}

.auth-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.98);
}

/* 用户欢迎区域 - 优化版 */
.user-welcome {
  text-align: center;
  margin-bottom: 35rpx;
  padding: 35rpx 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
  border-radius: 25rpx;
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.welcome-text {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.user-email {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  font-weight: 500;
  margin-bottom: 30rpx;
}

/* 用户操作按钮区域 - 参考网页版 */
.user-actions {
  display: flex;
  gap: 30rpx;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 30rpx;
}

.user-action-btn {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.12) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 48rpx;
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
  min-width: 240rpx;
  height: 160rpx;
  box-shadow: 
    0 8rpx 30rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.user-action-btn:active {
  transform: translateY(-4rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.18) 100%);
  border-color: rgba(255, 255, 255, 0.4);
  box-shadow: 
    0 16rpx 50rpx rgba(0, 0, 0, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
}

.user-action-btn .btn-icon {
  font-size: 40rpx;
  opacity: 0.9;
}

.user-action-btn .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 主要操作按钮 - 优化版 */
.primary-action {
  text-align: center;
  margin-top: 10rpx;
}

.primary-btn {
  padding: 28rpx 60rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.15));
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50rpx;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 25rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 auto;
}

.primary-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.6);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* 功能特色区域 - 完全匹配网页版 */
.feature-description {
  text-align: center;
  padding: 0;
}

.feature-title {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 50rpx;
  display: block;
  text-shadow: none;
  letter-spacing: 0;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 25rpx;
  text-align: left;
  margin-top: 30rpx;
}

.feature-item {
  padding: 50rpx 30rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
  box-shadow: none;
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
}

.feature-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea, #764ba2, #f093fb);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.feature-item:active::before {
  transform: scaleX(1);
}

.feature-item:active {
  transform: translateY(-10rpx);
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
  display: block;
  text-shadow: none;
}

.feature-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  display: block;
  font-weight: 400;
}


/* 动画效果 */
.fadeInUp {
  animation: fadeInUp 0.8s ease-out;
}

.slideInLeft {
  animation: slideInLeft 0.8s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .container {
    max-width: 100%;
    padding: 16rpx;
    margin: 0;
  }
  
  .feature-grid {
    grid-template-columns: 1fr;
  }
  
  .action-grid {
    grid-template-columns: 1fr;
  }
  
  .auth-buttons {
    flex-direction: column;
    gap: 15rpx;
  }
  
  .auth-btn {
    width: 100%;
  }
}

/* 星空入口 */
.star-sky-entry {
  margin-top: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #0a0e27 0%, #1a1447 100%);
  border-radius: 30rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.3);
  box-shadow: 0 10rpx 30rpx rgba(26, 20, 71, 0.5);
  position: relative;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s ease;
}

.star-sky-entry:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.star-sky-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  opacity: 0.3;
  pointer-events: none;
}

.star-icon {
  font-size: 60rpx;
  animation: float-star 3s ease-in-out infinite;
}

.star-icon:nth-child(1) {
  animation-delay: 0s;
}

.star-icon:nth-child(2) {
  animation-delay: 1s;
}

.star-icon:nth-child(3) {
  animation-delay: 2s;
}

@keyframes float-star {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-10rpx) scale(1.1);
    opacity: 0.6;
  }
}

.star-sky-info {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
}

.star-sky-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.5);
}

.star-sky-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}
}