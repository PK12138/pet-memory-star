/* pages/index/index.wxss */

/* 全屏容器 */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
}

.starry-container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
}

/* 星空画布 */
.star-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 欢迎遮罩�?*/
.welcome-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
  animation: fadeIn 0.8s ease-out;
}

.welcome-content {
  text-align: center;
  padding: 80rpx 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.welcome-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
  animation: float 3s ease-in-out infinite;
  filter: drop-shadow(0 0 20rpx rgba(255, 169, 77, 0.6));
}

.welcome-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 20rpx;
  text-shadow: 0 0 20rpx rgba(255, 255, 255, 0.5);
}

.welcome-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.welcome-hint {
  font-size: 24rpx;
  color: rgba(255, 169, 77, 0.9);
  display: block;
  animation: pulse 2s ease-in-out infinite;
}

/* 顶部信息�?*/
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  padding-top: calc(30rpx + env(safe-area-inset-top));
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), transparent);
  backdrop-filter: blur(10rpx);
}

.top-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

.star-count {
  font-size: 22rpx;
  color: rgba(255, 169, 77, 0.9);
  font-weight: 500;
}

.top-right {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.user-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 滑动提示 */
.swipe-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  padding: 30rpx 50rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(15rpx);
  animation: swipeHintFade 3s ease-in-out forwards;
  pointer-events: none;
}

.hint-icon {
  font-size: 60rpx;
  animation: swipeUpDown 1.5s ease-in-out infinite;
}

.hint-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

@keyframes swipeHintFade {
  0%, 50% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

@keyframes swipeUpDown {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

/* 底部悬浮操作球 */
.float-menu {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 80rpx;
  padding: 25rpx 40rpx;
  padding-bottom: calc(25rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
  backdrop-filter: blur(25rpx);
}

.float-menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 20rpx 30rpx;
  border-radius: 25rpx;
  transition: all 0.3s ease;
}

.float-menu-item:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.95);
}

.menu-icon {
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.3);
}

.create-icon {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.3), rgba(204, 122, 61, 0.3));
  border-color: rgba(255, 169, 77, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(255, 169, 77, 0.4);
  animation: pulse-glow 2s ease-in-out infinite;
}

.profile-icon {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.25), rgba(204, 122, 61, 0.25));
  border-color: rgba(255, 169, 77, 0.4);
  box-shadow: 0 4rpx 15rpx rgba(255, 169, 77, 0.3);
}

.float-menu-item:active .menu-icon {
  transform: scale(1.1);
  box-shadow: 0 8rpx 25rpx rgba(255, 255, 255, 0.3);
}

.menu-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
  letter-spacing: 1rpx;
}

.badge {
  position: absolute;
  top: 8rpx;
  right: 15rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #ff4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 68, 68, 0.6);
  animation: badge-pulse 2s ease-in-out infinite;
}

/* 星星详情弹窗 */
.star-detail-modal {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 200;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(15rpx);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.star-detail-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 90%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #1a2840 0%, #0d1520 100%);
  border-radius: 30rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 10rpx 50rpx rgba(15, 27, 46, 0.6), 0 0 30rpx rgba(255, 169, 77, 0.3);
  border: 2rpx solid rgba(255, 169, 77, 0.4);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.star-detail-modal.show .modal-content {
  transform: translate(-50%, -50%) scale(1);
}

.star-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  position: relative;
}

.star-avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 169, 77, 0.6);
  box-shadow: 0 0 20rpx rgba(255, 169, 77, 0.4);
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.3), rgba(204, 122, 61, 0.3));
}

.star-avatar {
  width: 100%;
  height: 100%;
}

.star-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.3), rgba(204, 122, 61, 0.3));
}

.placeholder-emoji {
  font-size: 60rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.3));
}

.star-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.star-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

.star-dates {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.close-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #fff;
  font-size: 32rpx;
  font-weight: 300;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.star-description {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
  margin-bottom: 30rpx;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.star-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 25rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.3), rgba(204, 122, 61, 0.3));
  border-color: rgba(255, 169, 77, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(255, 169, 77, 0.3);
}

.action-btn:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.2);
}

.action-btn.primary:active {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.4), rgba(204, 122, 61, 0.4));
}

.btn-icon {
  font-size: 32rpx;
}

/* 加载遮罩 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10rpx);
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: rgba(255, 169, 77, 0.9);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}


@keyframes float {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

@keyframes pulse-glow {
  0%, 100% {
    box-shadow: 0 4rpx 20rpx rgba(255, 169, 77, 0.4);
  }
  50% {
    box-shadow: 0 4rpx 30rpx rgba(255, 169, 77, 0.8);
  }
}

@keyframes badge-pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.feedback-float-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe099 0%, #ffd466 60%, #ffab27 100%);
  box-shadow: 0 0 16rpx 4rpx #ffd466, 0 6rpx 24rpx 0 rgba(255,170,50,0.23);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 14rpx;
  animation: glowPulse 2s infinite alternate;
}
.feedback-emoji {
  font-size: 36rpx;
  filter: drop-shadow(0 0 16rpx #fff9cc) drop-shadow(0 2rpx 10rpx #fffbc4);
  animation: envelopePulse .8s infinite alternate, envelopeFloat 2.8s ease-in-out infinite;
}
@keyframes envelopePulse {
  from { transform: scale(0.97); }
  to { transform: scale(1.13); }
}
@keyframes envelopeFloat {
  0%, 100% { transform: translateY(0); }
  60% { transform: translateY(-8rpx); }
}
