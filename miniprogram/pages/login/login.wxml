<!--pages/login/login.wxml-->
<view class="container">
  <!-- 顶部装饰 -->
  <view class="header">
    <text class="logo-icon">🌟</text>
    <text class="logo">爪迹星·云纪念馆</text>
    <text class="slogan">每一颗星星，都是永恒的陪伴</text>
  </view>
  
  <!-- 中间插画区域 -->
  <view class="illustration">
    <text class="ill-icon">🐾</text>
    <view class="ill-glow"></view>
  </view>
  
  <!-- 消息提示 -->
  <view wx:if="{{successMessage}}" class="success-message fadeIn">{{successMessage}}</view>
  <view wx:if="{{errorMessage}}" class="error-message fadeIn">{{errorMessage}}</view>
  
  <!-- 微信登录按钮 -->
  <button 
    class="wx-login-btn {{loading ? 'loading' : ''}}" 
    bindtap="wxLogin"
    disabled="{{loading}}"
  >
    <text class="btn-icon">{{loading ? '⏳' : '🚀'}}</text>
    <text class="btn-text">{{loading ? '登录中...' : '微信一键登录'}}</text>
  </button>
  
  <!-- 协议 -->
  <view class="agreement">
    <text class="agreement-text">登录即表示同意</text>
    <text class="link" bindtap="viewPrivacy">《隐私政策》</text>
    <text class="agreement-text">和</text>
    <text class="link" bindtap="viewTerms">《服务条款》</text>
  </view>
  
  <!-- 返回首页 -->
  <view class="back-home" bindtap="goToHome">
    <text class="back-icon">←</text>
    <text class="back-text">返回首页</text>
  </view>
</view>