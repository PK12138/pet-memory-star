/* pages/login/login.wxss - 微信一键登录 */

page {
  height: 100%;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  position: relative;
  overflow: hidden;
}

/* 动态星空背景 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(circle at 20% 80%, rgba(255, 169, 77, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 169, 77, 0.1) 0%, transparent 50%);
  z-index: 0;
  animation: float 20s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  33% { transform: translateY(-20rpx) rotate(1deg); }
  66% { transform: translateY(10rpx) rotate(-1deg); }
}

/* 顶部 Logo 区域 */
.header {
  text-align: center;
  margin-bottom: 80rpx;
  position: relative;
  z-index: 1;
  animation: fadeInDown 0.8s ease-out;
}

.logo-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: float 3s ease-in-out infinite;
  filter: drop-shadow(0 10rpx 30rpx rgba(255, 169, 77, 0.5));
}

.logo {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  display: block;
  margin-bottom: 15rpx;
  text-shadow: 0 4rpx 20rpx rgba(255, 169, 77, 0.3);
  letter-spacing: 2rpx;
}

.slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* 中间插画区域 */
.illustration {
  position: relative;
  margin-bottom: 100rpx;
  z-index: 1;
  animation: fadeInUp 1s ease-out 0.3s backwards;
}

.ill-icon {
  font-size: 160rpx;
  display: block;
  position: relative;
  z-index: 2;
  animation: bounce 2s ease-in-out infinite;
  filter: drop-shadow(0 10rpx 40rpx rgba(255, 169, 77, 0.4));
}

.ill-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 250rpx;
  height: 250rpx;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.3) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulse 3s ease-in-out infinite;
  z-index: 1;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

@keyframes pulse {
  0%, 100% { 
    transform: translate(-50%, -50%) scale(1); 
    opacity: 0.8;
  }
  50% { 
    transform: translate(-50%, -50%) scale(1.2); 
    opacity: 0.4;
  }
}

/* 消息提示 */
.success-message,
.error-message {
  width: 80%;
  max-width: 500rpx;
  padding: 24rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
  z-index: 1;
  backdrop-filter: blur(10rpx);
}

.success-message {
  background: rgba(46, 204, 113, 0.2);
  border: 2rpx solid rgba(46, 204, 113, 0.4);
  color: #2ecc71;
}

.error-message {
  background: rgba(231, 76, 60, 0.2);
  border: 2rpx solid rgba(231, 76, 60, 0.4);
  color: #e74c3c;
}

/* 微信登录按钮 */
.wx-login-btn {
  width: 80%;
  max-width: 500rpx;
  padding: 30rpx 50rpx;
  background: linear-gradient(135deg, #ffa94d 0%, #ff8c42 100%);
  border: none;
  border-radius: 50rpx;
  color: white;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 
    0 10rpx 30rpx rgba(255, 169, 77, 0.4),
    0 5rpx 15rpx rgba(255, 140, 66, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  transition: all 0.3s ease;
  margin-bottom: 40rpx;
  z-index: 1;
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.8s ease-out 0.6s backwards;
}

.wx-login-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: transform 0.6s;
}

.wx-login-btn:active {
  transform: scale(0.97);
  box-shadow: 
    0 5rpx 20rpx rgba(255, 169, 77, 0.6),
    0 2rpx 10rpx rgba(255, 140, 66, 0.5),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.wx-login-btn:active::before {
  transform: translate(100%, 100%);
}

.wx-login-btn.loading {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.6) 0%, rgba(255, 140, 66, 0.6) 100%);
  animation: pulse-btn 1.5s ease-in-out infinite;
}

@keyframes pulse-btn {
  0%, 100% { 
    box-shadow: 0 10rpx 30rpx rgba(255, 169, 77, 0.3);
  }
  50% { 
    box-shadow: 0 10rpx 40rpx rgba(255, 169, 77, 0.5);
  }
}

.btn-icon {
  font-size: 36rpx;
  animation: rotate-icon 2s linear infinite;
}

.wx-login-btn.loading .btn-icon {
  animation: rotate-icon 1s linear infinite;
}

@keyframes rotate-icon {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 协议区域 */
.agreement {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 0 40rpx;
  margin-bottom: 60rpx;
  z-index: 1;
  animation: fadeIn 1s ease-out 0.9s backwards;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.link {
  font-size: 24rpx;
  color: #ffa94d;
  text-decoration: underline;
  font-weight: 500;
}

.link:active {
  opacity: 0.7;
}

/* 返回首页 */
.back-home {
  position: absolute;
  bottom: 50rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  z-index: 1;
  animation: fadeIn 1s ease-out 1.2s backwards;
}

.back-icon {
  font-size: 32rpx;
}

.back-text {
  font-weight: 500;
  text-decoration: underline;
}

.back-home:active {
  opacity: 0.6;
}

/* 动画效果 */
.fadeIn {
  animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.fadeInDown {
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fadeInUp {
  animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .container {
    padding: 40rpx 30rpx;
  }
  
  .header {
    margin-bottom: 60rpx;
  }
  
  .logo-icon {
    font-size: 80rpx;
  }
  
  .logo {
    font-size: 40rpx;
  }
  
  .illustration {
    margin-bottom: 80rpx;
  }
  
  .ill-icon {
    font-size: 120rpx;
  }
  
  .wx-login-btn {
    width: 90%;
    padding: 26rpx 40rpx;
    font-size: 30rpx;
  }
  
  .btn-icon {
    font-size: 32rpx;
  }
  
  .btn-text {
    font-size: 30rpx;
  }
}
