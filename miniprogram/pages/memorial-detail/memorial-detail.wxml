<!--pages/memorial-detail/memorial-detail.wxml-->
<view class="container">
  <!-- 纪念馆头部 -->
  <view class="memorial-header">
    <view class="header-content">
      <text class="pet-name">{{memorialInfo.pet_name}}</text>
      <text class="pet-species">{{memorialInfo.species}} · {{memorialInfo.breed}}</text>
      <text class="pet-dates">{{memorialInfo.birth_date}} - {{memorialInfo.memorial_date}}</text>
    </view>
    
    <view class="header-actions">
      <button class="action-btn btn-chat" bindtap="goToAIChat">
        <text class="btn-icon">💬</text>
      </button>
      <button class="action-btn btn-edit" bindtap="editMemorial">
        <text class="btn-icon">✏️</text>
      </button>
      <button class="action-btn btn-share" bindtap="shareMemorial">
        <text class="btn-icon">📤</text>
      </button>
    </view>
  </view>
  
  <!-- 纪念馆照片 -->
  <view wx:if="{{memorialInfo.photos && memorialInfo.photos.length > 0}}" class="photo-section">
    <text class="section-title">珍贵回忆</text>
    <view class="photo-grid">
      <image 
        wx:for="{{memorialInfo.photos}}" 
        wx:key="*this"
        class="photo-item" 
        src="{{item}}" 
        mode="aspectFill"
        bindtap="previewPhoto"
        data-url="{{item}}"
      />
    </view>
  </view>
  
  <!-- AI信件 -->
  <view wx:if="{{memorialInfo.ai_letter && memorialInfo.pet_status !== 'alive'}}" class="ai-letter-section">
    <text class="section-title">💌 来自{{memorialInfo.pet_name}}的信</text>
    <view class="letter-content">
      <text class="letter-text">{{memorialInfo.ai_letter}}</text>
    </view>
  </view>
  
  <!-- 性格特点 -->
  <view wx:if="{{memorialInfo.personality}}" class="personality-section">
    <text class="section-title">🌟 性格分析</text>
    <view class="personality-content">
      <text class="personality-text">{{memorialInfo.personality}}</text>
    </view>
  </view>
  
  <!-- 留言板 -->
  <view class="messages-section">
    <text class="section-title">访客留言</text>
    
    <!-- 留言列表 -->
    <view wx:if="{{messages.length > 0}}" class="messages-list">
      <view wx:for="{{messages}}" wx:key="index" class="message-item">
        <view class="message-header">
          <text class="message-author">{{item.visitor_name}}</text>
          <text class="message-time">{{item.created_at}}</text>
        </view>
        <view class="message-content">
          <text class="message-text">{{item.message}}</text>
        </view>
      </view>
    </view>
    
    <!-- 无留言提示 -->
    <view wx:if="{{messages.length === 0}}" class="no-messages">
      <text class="no-messages-icon">💬</text>
      <text class="no-messages-text">还没有留言，快来留下第一条祝福吧~</text>
    </view>
    
    <!-- 添加留言 -->
    <view class="add-message-section">
      <text class="add-message-label">留下您的祝福</text>
      
      <view class="input-group">
        <input 
          class="name-input" 
          placeholder="您的昵称" 
          value="{{newMessage.name}}"
          bindinput="onNameInput"
          maxlength="20"
        />
      </view>
      
      <view class="input-group">
        <textarea 
          class="message-textarea" 
          placeholder="写下您的留言..." 
          value="{{newMessage.content}}"
          bindinput="onMessageInput"
          maxlength="200"
          auto-height
        />
        <text class="char-count">{{newMessage.content.length}}/200</text>
      </view>
      
      <button 
        class="btn-submit-message" 
        bindtap="submitMessage"
        disabled="{{!newMessage.name || !newMessage.content || submitting}}"
      >
        {{submitting ? '发送中...' : '发送留言'}}
      </button>
    </view>
  </view>
  
  <!-- 纪念日提醒 -->
  <view class="reminder-section">
    <text class="section-title">纪念日提醒</text>
    <view class="feature-card">
      <view class="feature-icon">⏰</view>
      <view class="feature-info">
        <text class="feature-title">设置重要的纪念日期</text>
        <text class="feature-desc">我们会在特殊日子提醒您</text>
      </view>
      <button class="feature-btn" bindtap="goToReminderSetup">
        <text>设置提醒</text>
      </button>
    </view>
  </view>
  
  <!-- 心情日记 -->
  <view class="diary-section">
    <text class="section-title">心情日记</text>
    <view class="feature-card">
      <view class="feature-icon">📝</view>
      <view class="feature-info">
        <text class="feature-title">记录您的心情</text>
        <text class="feature-desc">记录对TA的思念和回忆</text>
      </view>
      <button class="feature-btn" bindtap="goToMoodDiary">
        <text>写日记</text>
      </button>
    </view>
  </view>
  
  <!-- 虚拟陪伴 -->
  <view class="companion-section">
    <text class="section-title">虚拟陪伴</text>
    <view class="feature-card companion-card">
      <view class="feature-icon">🤖</view>
      <view class="feature-info">
        <text class="feature-title">智能互动陪伴</text>
        <text class="feature-desc">与TA互动游戏，获取主动问候</text>
      </view>
      <button class="feature-btn companion-btn" bindtap="goToVirtualCompanion">
        <text>开始陪伴</text>
      </button>
    </view>
  </view>

  <!-- 梦境日记 -->
  <view class="dream-section">
    <text class="section-title">梦境日记</text>
    <view class="feature-card dream-card">
      <view class="feature-icon">🌙</view>
      <view class="feature-info">
        <text class="feature-title">记录梦中重逢</text>
        <text class="feature-desc">记录每一次在梦中与TA的相遇</text>
      </view>
      <button class="feature-btn dream-btn" bindtap="goToDreamDiary">
        <text>查看梦境</text>
      </button>
    </view>
  </view>
  
  <!-- 纪念馆信息 -->
  <view class="info-section">
    <text class="section-title">详细信息</text>
    
    <view class="info-grid">
      <view wx:if="{{memorialInfo.age}}" class="info-item">
        <text class="info-label">年龄</text>
        <text class="info-value">{{memorialInfo.age}} 岁</text>
      </view>
      
      <view wx:if="{{memorialInfo.gender}}" class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{memorialInfo.gender}}</text>
      </view>
      
      <view wx:if="{{memorialInfo.color}}" class="info-item">
        <text class="info-label">毛色</text>
        <text class="info-value">{{memorialInfo.color}}</text>
      </view>
      
      <view wx:if="{{memorialInfo.weight}}" class="info-item">
        <text class="info-label">体重</text>
        <text class="info-value">{{memorialInfo.weight}} kg</text>
      </view>
    </view>
  </view>
  
  <!-- 纪念馆描述 -->
  <view wx:if="{{memorialInfo.description}}" class="description-section">
    <text class="section-title">纪念馆描述</text>
    <view class="description-content">
      <text class="description-text">{{memorialInfo.description}}</text>
    </view>
  </view>
  
  <!-- 访问统计 -->
  <view class="stats-section">
    <text class="section-title">访问统计</text>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-icon">📸</text>
        <text class="stat-number">{{memorialInfo.photos.length || 0}}</text>
        <text class="stat-label">张照片</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">👁️</text>
        <text class="stat-number">{{visitStats.total_visits}}</text>
        <text class="stat-label">次访问</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">👥</text>
        <text class="stat-number">{{visitStats.unique_visitors}}</text>
        <text class="stat-label">位访客</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">💬</text>
        <text class="stat-number">{{messages.length}}</text>
        <text class="stat-label">条留言</text>
      </view>
    </view>
  </view>
  
  <!-- 创建信息 -->
  <view class="meta-section">
    <text class="meta-text">创建于 {{memorialInfo.created_at}}</text>
    <text wx:if="{{memorialInfo.updated_at}}" class="meta-text">最后更新 {{memorialInfo.updated_at}}</text>
  </view>
</view>