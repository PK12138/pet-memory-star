/* pages/memorial-detail/memorial-detail.wxss */

.container {
  min-height: 100vh;
  background: radial-gradient(ellipse at bottom, #1a1f3a 0%, #0e1420 100%);
  padding: 20rpx;
}

/* 纪念馆头�?*/
.memorial-header {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-content {
  flex: 1;
}

.pet-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 15rpx;
}

.pet-species {
  display: block;
  font-size: 28rpx;
  color: #7f8c8d;
  margin-bottom: 10rpx;
}

.pet-dates {
  display: block;
  font-size: 24rpx;
  color: #95a5a6;
}

.header-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  width: 80rpx;
  height: 80rpx;
  border: none;
  border-radius: 20rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.btn-chat {
  background: radial-gradient(ellipse at top, #3d4e7a 0%, #2a3651 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.btn-chat:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 10rpx rgba(102, 126, 234, 0.3);
}

.btn-edit {
  background: #3498db;
  color: white;
}

.btn-edit:active {
  background: #2980b9;
  transform: scale(0.95);
}

.btn-share {
  background: #2ecc71;
  color: white;
}

.btn-share:active {
  background: #27ae60;
  transform: scale(0.95);
}

/* 通用区域样式 */
.photo-section,
.info-section,
.description-section,
.personality-section,
.stats-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 照片区域 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200rpx, 1fr));
  gap: 20rpx;
}

.photo-item {
  width: 100%;
  height: 200rpx;
  border-radius: 15rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.photo-item:active {
  transform: scale(0.95);
}

/* 信息区域 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200rpx, 1fr));
  gap: 20rpx;
}

.info-item {
  background: rgba(102, 126, 234, 0.1);
  border-radius: 15rpx;
  padding: 25rpx;
  text-align: center;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
  margin-bottom: 10rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

/* 描述区域 */
.description-content {
  background: rgba(102, 126, 234, 0.05);
  border-radius: 15rpx;
  padding: 30rpx;
}

.description-text {
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.6;
  text-align: center;
}

/* AI信件区域 */
.ai-letter-section {
  padding: 30rpx 20rpx;
  background: #fff;
}

.letter-content {
  padding: 30rpx;
  background: linear-gradient(135deg, #fef4e4 0%, #fff9f0 100%);
  border-radius: 20rpx;
  border: 2rpx solid #f0e4d7;
  position: relative;
}

.letter-content::before {
  content: '💌';
  position: absolute;
  top: -15rpx;
  right: 20rpx;
  font-size: 40rpx;
  background: #fff;
  padding: 5rpx;
  border-radius: 50%;
}

.letter-text {
  font-size: 28rpx;
  color: #5d4e37;
  line-height: 2;
  white-space: pre-wrap;
}

/* 性格区域 */
.personality-content {
  background: rgba(46, 204, 113, 0.05);
  border-radius: 15rpx;
  padding: 30rpx;
}

.personality-text {
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.6;
  text-align: center;
}

/* 统计区域 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-item {
  background: rgba(102, 126, 234, 0.1);
  border-radius: 15rpx;
  padding: 30rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.stat-item:active {
  background: rgba(102, 126, 234, 0.2);
  transform: scale(0.95);
}

.stat-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 15rpx;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #7f8c8d;
}

/* 元信息区�?*/
.meta-section {
  text-align: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.meta-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.meta-text:last-child {
  margin-bottom: 0;
}

/* 响应式设�?*/
@media (max-width: 750rpx) {
  .container {
    padding: 16rpx;
  }
  
  .memorial-header {
    flex-direction: column;
    gap: 20rpx;
  }
  
  .header-actions {
    align-self: flex-end;
  }
  
  .info-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .stats-grid {
    grid-template-columns: 1fr;
    gap: 15rpx;
  }
  
  .photo-grid {
    grid-template-columns: repeat(auto-fill, minmax(150rpx, 1fr));
    gap: 15rpx;
  }
}

/* 留言板区�?*/
.messages-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.messages-list {
  margin-bottom: 40rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.message-item {
  background: rgba(102, 126, 234, 0.05);
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.message-item:last-child {
  margin-bottom: 0;
}

.message-item:active {
  background: rgba(102, 126, 234, 0.1);
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.message-author {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

.message-time {
  font-size: 22rpx;
  color: #95a5a6;
}

.message-content {
  padding: 15rpx 0;
}

.message-text {
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.6;
  word-wrap: break-word;
}

/* 无留言提示 */
.no-messages {
  text-align: center;
  padding: 60rpx 0;
}

.no-messages-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.no-messages-text {
  display: block;
  font-size: 26rpx;
  color: #95a5a6;
}

/* 添加留言区域 */
.add-message-section {
  background: rgba(102, 126, 234, 0.05);
  border-radius: 15rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.add-message-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.input-group {
  margin-bottom: 20rpx;
  position: relative;
}

.name-input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  border: 2rpx solid rgba(102, 126, 234, 0.1);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.name-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.message-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  border: 2rpx solid rgba(102, 126, 234, 0.1);
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.6;
}

.message-textarea:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #95a5a6;
  margin-top: 10rpx;
}

.btn-submit-message {
  width: 100%;
  height: 88rpx;
  background: radial-gradient(ellipse at bottom, #1a1f3a 0%, #0e1420 100%);
  border: none;
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.btn-submit-message:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.3);
}

.btn-submit-message:disabled {
  opacity: 0.5;
  transform: none;
}

/* 功能卡片样式 */
.reminder-section,
.diary-section {
  padding: 30rpx 20rpx;
  background: #fff;
}

.companion-section {
  padding: 30rpx 20rpx;
  background: #fff;
}

.companion-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

.companion-btn {
  background: radial-gradient(ellipse at top, #3d4e7a 0%, #2a3651 100%) !important;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.feature-card {
  background: linear-gradient(135deg, #f5f7fa 0%, #ffffff 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #f0f0f0;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  font-size: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.feature-desc {
  font-size: 26rpx;
  color: #7f8c8d;
}

.feature-btn {
  background: radial-gradient(ellipse at bottom, #1a1f3a 0%, #0e1420 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 35rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.feature-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 梦境日记部分 */
.dream-section {
  margin: 30rpx 0;
}

.dream-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  border: 2rpx solid rgba(102, 126, 234, 0.15);
}

.dream-btn {
  background: radial-gradient(ellipse at bottom, #1a1f3a 0%, #0e1420 100%);
  color: #ffffff;
}

