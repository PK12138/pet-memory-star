/* pages/mood-diary/mood-diary.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #ffa94d 0%, #cc7a3d 100%);
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 15rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 日记列表区域 */
.diaries-section {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  min-height: calc(100vh - 200rpx);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.add-btn {
  background: linear-gradient(135deg, #ffa94d 0%, #cc7a3d 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 15rpx 30rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  line-height: 1;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

/* 日记卡片 */
.diaries-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.diary-card {
  background: #ffffff;
  border: 2rpx solid #f0f0f0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.diary-card:active {
  transform: scale(0.98);
}

.diary-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.mood-badge {
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex: 1;
}

.mood-emoji {
  font-size: 60rpx;
}

.mood-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mood-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.mood-score-bar {
  width: 100%;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
  transition: width 0.3s ease;
}

.diary-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.diary-date {
  font-size: 24rpx;
  color: #95a5a6;
}

.weather-icon {
  font-size: 32rpx;
}

.diary-content {
  padding: 20rpx;
  background: rgba(240, 147, 251, 0.05);
  border-radius: 15rpx;
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.8;
}

/* 空状�?*/
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #95a5a6;
  margin-bottom: 15rpx;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #bdc3c7;
  display: block;
}

/* 对话框遮�?*/
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 对话框容�?*/
.dialog-container {
  width: 90%;
  max-width: 600rpx;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
  display: flex;
  flex-direction: column;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #ffa94d 0%, #cc7a3d 100%);
  flex-shrink: 0;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.dialog-close {
  font-size: 60rpx;
  color: #ffffff;
  line-height: 1;
  width: 60rpx;
  text-align: center;
}

.dialog-content {
  padding: 40rpx;
  overflow-y: auto;
  flex: 1;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #2c3e50;
  margin-bottom: 15rpx;
  font-weight: 500;
}

/* 心情类型选择 */
.mood-types {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  background: #ffffff;
  transition: all 0.3s ease;
}

.mood-item.active {
  border-color: #f093fb;
  background: rgba(240, 147, 251, 0.1);
  transform: scale(1.05);
}

.mood-item-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.mood-item-name {
  font-size: 24rpx;
  color: #2c3e50;
}

/* 天气选择 */
.weather-types {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
}

.weather-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  background: #ffffff;
  transition: all 0.3s ease;
}

.weather-item.active {
  border-color: #f093fb;
  background: rgba(240, 147, 251, 0.1);
  transform: scale(1.05);
}

.weather-emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.weather-name {
  font-size: 22rpx;
  color: #2c3e50;
}

/* 日记输入�?*/
.diary-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  font-size: 28rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.char-count {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #95a5a6;
  text-align: right;
}

/* 对话框底�?*/
.dialog-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 40rpx;
  background: #f8f9fa;
  flex-shrink: 0;
}

.btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 15rpx;
  font-size: 30rpx;
  border: none;
  line-height: 1;
}

.btn-cancel {
  background: #ecf0f1;
  color: #7f8c8d;
}

.btn-confirm {
  background: linear-gradient(135deg, #ffa94d 0%, #cc7a3d 100%);
  color: #ffffff;
}

