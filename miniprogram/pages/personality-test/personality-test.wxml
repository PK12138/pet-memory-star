<!--pages/personality-test/personality-test.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">宠物性格测试</text>
    <text class="page-subtitle">了解您的宠物，创建专属纪念馆</text>
  </view>
  
  <!-- 进度条 - 只在非基本信息页显示 -->
  <view wx:if="{{!showPetInfo}}" class="progress-section">
    <text class="progress-text">第 {{currentQuestion}} 题 / 共 {{totalQuestions}} 题</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
  </view>
  
  <!-- 宠物基本信息 -->
  <view wx:if="{{showPetInfo}}" class="pet-info-section">
    <text class="section-title">宠物基本信息</text>
    <view class="form-list">
      <!-- 宠物姓名 -->
      <view class="form-group-full">
        <text class="form-label">宠物姓名 <text class="required">*</text></text>
        <input 
          class="form-input" 
          type="text" 
          placeholder="请输入宠物姓名"
          value="{{petInfo.name}}"
          bindinput="onPetNameInput"
        />
      </view>
      
      <!-- 宠物种类 -->
      <view class="form-group-full">
        <text class="form-label">宠物种类 <text class="required">*</text></text>
        <picker 
          class="form-picker" 
          mode="selector" 
          range="{{speciesOptions}}"
          value="{{petInfo.speciesIndex}}"
          bindchange="onSpeciesChange"
        >
          <view class="picker-text">{{petInfo.species || '请选择'}}</view>
        </picker>
      </view>
      
      <!-- 品种 -->
      <view class="form-group-full">
        <text class="form-label">品种</text>
        <input 
          class="form-input" 
          type="text" 
          placeholder="如：金毛、英短、金毛等"
          value="{{petInfo.breed}}"
          bindinput="onPetBreedInput"
        />
      </view>
      
      <!-- 毛色 -->
      <view class="form-group-full">
        <text class="form-label">毛色</text>
        <input 
          class="form-input" 
          type="text" 
          placeholder="如：白色、橘色等"
          value="{{petInfo.color}}"
          bindinput="onPetColorInput"
        />
      </view>
      
      <!-- 性别 -->
      <view class="form-group-full">
        <text class="form-label">性别</text>
        <picker 
          class="form-picker" 
          mode="selector" 
          range="{{genderOptions}}"
          value="{{petInfo.genderIndex}}"
          bindchange="onGenderChange"
        >
          <view class="picker-text">{{petInfo.gender || '请选择'}}</view>
        </picker>
      </view>
      
      <!-- 体重 -->
      <view class="form-group-full">
        <text class="form-label">体重(kg)</text>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="请输入体重"
          value="{{petInfo.weight}}"
          bindinput="onPetWeightInput"
        />
      </view>
      
      <!-- 出生日期 -->
      <view class="form-group-full">
        <text class="form-label">出生日期</text>
        <picker 
          class="form-picker" 
          mode="date" 
          value="{{petInfo.birthDate}}"
          bindchange="onBirthDateChange"
        >
          <view class="picker-text">{{petInfo.birthDate || '年/月/日'}}</view>
        </picker>
      </view>
      
      <!-- 纪念日期 -->
      <view class="form-group-full">
        <text class="form-label">纪念日期 <text class="required">*</text></text>
        <picker 
          class="form-picker" 
          mode="date" 
          value="{{petInfo.memorialDate}}"
          bindchange="onMemorialDateChange"
        >
          <view class="picker-text">{{petInfo.memorialDate || '年/月/日'}}</view>
        </picker>
      </view>
      
      <!-- 宠物状态 -->
      <view class="form-group-full">
        <text class="form-label">宠物状态 <text class="required">*</text></text>
        <picker 
          class="form-picker" 
          mode="selector" 
          range="{{statusOptions}}"
          value="{{petInfo.statusIndex}}"
          bindchange="onStatusChange"
        >
          <view class="picker-text">{{petInfo.status || '请选择'}}</view>
        </picker>
        <text class="form-hint">选择"健在"时，AI信件将被隐藏，直到您主动查看</text>
      </view>
      
      <!-- 上传照片 -->
      <view class="form-group-full">
        <text class="form-label">上传照片 <text class="required">*</text></text>
        <view class="upload-area" bindtap="chooseImage">
          <view wx:if="{{petInfo.photos.length === 0}}" class="upload-placeholder">
            <text class="upload-icon">📷</text>
            <text class="upload-text">选择文件</text>
            <text class="upload-hint">可以选多张照片</text>
          </view>
          <view wx:else class="image-list">
            <view wx:for="{{petInfo.photos}}" wx:key="*this" class="image-item">
              <image src="{{item}}" mode="aspectFill" class="preview-image"></image>
              <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
            </view>
            <view class="add-more-btn" bindtap="chooseImage">
              <text>+</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 问题容器 -->
  <view wx:if="{{currentQuestionData}}" class="question-container">
    <text class="question-text">第{{currentQuestion}}题：{{currentQuestionData.question}}</text>
    <view class="answer-options">
      <view 
        wx:for="{{currentQuestionOptions}}" 
        wx:key="*this"
        class="answer-option {{answers[currentQuestion] === item ? 'selected' : ''}}"
        bindtap="selectAnswer"
        data-option="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </view>
  
  <!-- 测试结果 -->
  <view wx:if="{{showResult}}" class="result-section">
    <text class="result-title">测试结果</text>
    <view class="result-content">
      <text class="result-text">{{personalityResult}}</text>
    </view>
    
    <view class="memorial-form">
      <text class="form-label">纪念馆描述</text>
      <textarea 
        class="form-textarea" 
        placeholder="请输入纪念馆描述"
        value="{{memorialInfo.description}}"
        bindinput="onDescriptionInput"
      ></textarea>
    </view>
  </view>
  
  <!-- 导航按钮 -->
  <view class="navigation">
    <button 
      wx:if="{{currentQuestion > 1 || showPetInfo}}" 
      class="btn btn-secondary" 
      bindtap="prevStep"
    >
      上一步
    </button>
    
    <button 
      wx:if="{{!showResult && (showPetInfo || currentQuestion <= totalQuestions)}}" 
      class="btn btn-primary" 
      bindtap="nextStep"
      disabled="{{!canProceed}}"
    >
      {{showPetInfo ? '开始性格测试' : (currentQuestion === totalQuestions ? '完成测试' : '下一步')}}
    </button>
    
    <button 
      wx:if="{{showResult}}" 
      class="btn btn-primary" 
      bindtap="createMemorial"
      disabled="{{loading}}"
    >
      {{loading ? '创建中...' : '创建纪念馆'}}
    </button>
  </view>
</view>