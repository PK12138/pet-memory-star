/* pages/personality-test/personality-test.wxss */

.container {
  padding: 30rpx 25rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
}

.page-header {
  text-align: center;
  margin-bottom: 50rpx;
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.15), rgba(204, 122, 61, 0.1));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.3);
  border-radius: 30rpx;
  color: white;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  text-shadow: 0 3rpx 10rpx rgba(255, 169, 77, 0.3);
  color: #ffa94d;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.page-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 169, 77, 0.9);
  font-weight: 500;
  margin-top: 10rpx;
}

/* 进度�?*/
.progress-section {
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.progress-text {
  display: block;
  text-align: center;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #45a049);
  transition: width 0.3s ease;
  border-radius: 10rpx;
}

/* 宠物信息区域 */
.pet-info-section {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.25);
  border-radius: 30rpx;
  padding: 45rpx 35rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

/* 区域标题 */
.section-header {
  text-align: center;
  margin-bottom: 45rpx;
}

.section-icon {
  display: block;
  font-size: 60rpx;
  margin-bottom: 15rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(255, 169, 77, 0.3));
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffa94d;
  margin-bottom: 15rpx;
  text-shadow: 0 3rpx 15rpx rgba(255, 169, 77, 0.4);
  letter-spacing: 2rpx;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
}

/* 单列表单布局 */
.form-list {
  display: flex;
  flex-direction: column;
  gap: 35rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
}

/* 全宽表单组 */
.form-group-full {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 15rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0.5rpx;
}

.label-icon {
  font-size: 30rpx;
  filter: drop-shadow(0 2rpx 5rpx rgba(255, 169, 77, 0.4));
}

.form-input {
  width: 100%;
  padding: 24rpx 25rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 15rpx;
  font-size: 28rpx;
  color: #ffffff;
  transition: all 0.3s ease;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
}

.form-input:focus {
  border-color: rgba(255, 255, 255, 0.6);
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.35);
}

.form-picker {
  width: 100%;
  padding: 24rpx 25rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 15rpx;
  font-size: 28rpx;
  color: white;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.picker-text {
  color: #ffffff;
  font-weight: 500;
}

/* 必填标记 */
.required {
  color: #ff6b6b;
  font-weight: 700;
  margin-left: 4rpx;
}

/* 表单提示 */
.form-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
  line-height: 1.4;
}

/* 上传区域 */
.upload-area {
  width: 100%;
  min-height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx dashed rgba(255, 255, 255, 0.4);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx;
  width: 100%;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 15rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(255, 0, 0, 0.8);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.add-more-btn {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.4);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: white;
  background: rgba(255, 255, 255, 0.05);
  transition: all 0.3s ease;
}

.add-more-btn:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.95);
}

/* 问题容器 */
.question-container {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.question-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 30rpx;
  line-height: 1.5;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.answer-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.answer-option {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 15rpx;
  padding: 25rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
}

.answer-option:active {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-2rpx);
}

.answer-option.selected {
  background: rgba(76, 175, 80, 0.6);
  border-color: #4CAF50;
  box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.3);
}

/* 结果区域 */
.result-section {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 20rpx;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.result-content {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.result-text {
  display: block;
  font-size: 28rpx;
  color: white;
  line-height: 1.6;
  text-align: center;
}

.memorial-form {
  margin-top: 30rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 15rpx;
  font-size: 26rpx;
  color: white;
  transition: all 0.3s ease;
  font-weight: 500;
}

.form-textarea::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 导航按钮 */
.navigation {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 20rpx;
}

.btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-primary {
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
  color: white;
  box-shadow: 0 8rpx 25rpx rgba(102, 126, 234, 0.4);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.6);
}

.btn-primary:disabled {
  opacity: 0.6;
  transform: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.98);
}

/* 简答题区域 */
.memory-section {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.25);
  border-radius: 30rpx;
  padding: 45rpx 35rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.memory-header {
  text-align: center;
  margin-bottom: 35rpx;
}

.memory-icon {
  display: block;
  font-size: 60rpx;
  margin-bottom: 15rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(255, 169, 77, 0.3));
}

.memory-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #ffa94d;
  margin-bottom: 12rpx;
  text-shadow: 0 3rpx 15rpx rgba(255, 169, 77, 0.4);
  letter-spacing: 2rpx;
}

.memory-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
  margin-bottom: 8rpx;
}

.memory-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 169, 77, 0.85);
  font-weight: 500;
  margin-top: 8rpx;
}

.memory-progress {
  text-align: center;
  margin-bottom: 35rpx;
  padding: 15rpx;
  background: rgba(255, 169, 77, 0.1);
  border-radius: 15rpx;
}

.memory-progress-text {
  font-size: 26rpx;
  color: #ffa94d;
  font-weight: 600;
}

.memory-question-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 25rpx;
  padding: 35rpx;
  border: 2rpx solid rgba(255, 169, 77, 0.2);
}

.memory-question-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 25rpx;
}

.memory-question-number {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: linear-gradient(135deg, #ffa94d, #cc7a3d);
  color: #0d1520;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50%;
  box-shadow: 0 4rpx 15rpx rgba(255, 169, 77, 0.4);
}

.memory-question-text {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.6;
  padding-top: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.memory-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx;
  background: rgba(255, 169, 77, 0.08);
  border-radius: 15rpx;
  margin-bottom: 25rpx;
  border-left: 4rpx solid #ffa94d;
}

.hint-icon {
  font-size: 28rpx;
  filter: drop-shadow(0 2rpx 5rpx rgba(255, 169, 77, 0.4));
}

.hint-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

.memory-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.3);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.memory-textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
  font-weight: 400;
}

.memory-textarea:focus {
  border-color: #ffa94d;
  box-shadow: 0 0 0 8rpx rgba(255, 169, 77, 0.15);
  background: rgba(255, 255, 255, 0.15);
}

.char-count {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5rpx;
  margin-top: 15rpx;
  font-size: 24rpx;
}

.count-current {
  color: #ffa94d;
  font-weight: 600;
}

.count-divider {
  color: rgba(255, 255, 255, 0.4);
}

.count-max {
  color: rgba(255, 255, 255, 0.5);
}

.count-hint {
  margin-left: 10rpx;
  color: rgba(255, 169, 77, 0.7);
  font-size: 22rpx;
  font-weight: 400;
}

/* 折叠区域样式 */
.expand-section {
  margin-top: 20rpx;
  padding-top: 25rpx;
  border-top: 2rpx dashed rgba(255, 169, 77, 0.2);
}

.expand-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  background: rgba(255, 169, 77, 0.08);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 169, 77, 0.2);
  transition: all 0.3s ease;
  cursor: pointer;
}

.expand-trigger:active {
  background: rgba(255, 169, 77, 0.15);
  transform: scale(0.98);
}

.expand-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.expand-icon {
  font-size: 24rpx;
  color: #ffa94d;
  font-weight: 600;
  transition: transform 0.3s ease;
}

.more-info-container {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 30rpx;
  background: rgba(255, 169, 77, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 169, 77, 0.15);
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设�?*/
@media (max-width: 750rpx) {
  .container {
    padding: 16rpx;
  }
  
  .form-grid {
    grid-template-columns: 1fr;
    gap: 20rpx;
  }
  
  .navigation {
    flex-direction: column;
  }
  
  .btn {
    width: 100%;
  }
}