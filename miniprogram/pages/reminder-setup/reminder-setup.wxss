/* pages/reminder-setup/reminder-setup.wxss */
.container {
  min-height: 100vh;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 15rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 提醒列表区域 */
.reminders-section {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  min-height: calc(100vh - 200rpx);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.add-btn {
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 15rpx 30rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  line-height: 1;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

/* 提醒卡片 */
.reminders-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-card {
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.reminder-card:active {
  transform: scale(0.98);
}

.reminder-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.reminder-type-badge {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 15rpx;
}

.reminder-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reminder-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.reminder-date {
  font-size: 26rpx;
  color: #7f8c8d;
}

.delete-btn {
  background: #ff6b6b;
  color: #ffffff;
  border: none;
  border-radius: 15rpx;
  padding: 15rpx 25rpx;
  font-size: 26rpx;
  line-height: 1;
}

.reminder-desc {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 15rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 空状�?*/
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #95a5a6;
  margin-bottom: 15rpx;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #bdc3c7;
  display: block;
}

/* 对话框遮�?*/
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 对话框容�?*/
.dialog-container {
  width: 90%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.dialog-close {
  font-size: 60rpx;
  color: #ffffff;
  line-height: 1;
  cursor: pointer;
  width: 60rpx;
  text-align: center;
}

.dialog-content {
  padding: 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #2c3e50;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.reminder-types {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  background: #ffffff;
  transition: all 0.3s ease;
}

.type-item.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  transform: scale(1.05);
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 26rpx;
  color: #2c3e50;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 150rpx;
  line-height: 1.6;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  background: #ffffff;
}

.picker-display .placeholder {
  color: #bdc3c7;
}

.picker-display .selected {
  color: #2c3e50;
}

.picker-arrow {
  font-size: 40rpx;
  color: #bdc3c7;
  transform: rotate(90deg);
}

/* 对话框底�?*/
.dialog-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 40rpx;
  background: #f8f9fa;
}

.btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 15rpx;
  font-size: 30rpx;
  border: none;
  line-height: 1;
}

.btn-cancel {
  background: #ecf0f1;
  color: #7f8c8d;
}

.btn-confirm {
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
  color: #ffffff;
}

