/* pages/theme-settings/theme-settings.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 15rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 主题列表区域 */
.themes-section {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  min-height: calc(100vh - 200rpx);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.reset-btn {
  background: #ecf0f1;
  color: #7f8c8d;
  border: none;
  border-radius: 50rpx;
  padding: 15rpx 25rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  line-height: 1;
}

.reset-icon {
  font-size: 32rpx;
  margin-right: 5rpx;
  font-weight: bold;
}

/* 主题网格 */
.themes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

/* 主题卡片 */
.theme-card {
  background: #ffffff;
  border: 3rpx solid #e0e0e0;
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
}

.theme-card:active {
  transform: scale(0.95);
}

.theme-card.active {
  border-color: #667eea;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transform: scale(1.02);
}

/* 选中标记 */
.selected-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  width: 50rpx;
  height: 50rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.badge-icon {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

/* 主题预览 */
.theme-preview {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.theme-icon {
  font-size: 80rpx;
}

/* 主题信息 */
.theme-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.theme-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.theme-desc {
  font-size: 24rpx;
  color: #95a5a6;
  line-height: 1.5;
}

/* 颜色预览 */
.color-preview {
  display: flex;
  gap: 10rpx;
  padding: 0 20rpx 20rpx;
}

.color-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 提示信息 */
.tips {
  background: rgba(102, 126, 234, 0.1);
  border-radius: 15rpx;
  padding: 25rpx;
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  margin-bottom: 40rpx;
}

.tips-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 26rpx;
  color: #667eea;
  line-height: 1.8;
  flex: 1;
}

/* 当前主题预览 */
.current-preview {
  padding: 0 40rpx 40rpx;
}

.preview-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.preview-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.preview-content {
  display: flex;
  flex-direction: column;
}

.preview-header {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.preview-icon {
  font-size: 80rpx;
}

.preview-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.preview-body {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.preview-color {
  padding: 15rpx 25rpx;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.color-code {
  font-size: 24rpx;
  color: #ffffff;
  font-family: monospace;
  font-weight: bold;
}

.preview-desc {
  padding: 20rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 15rpx;
  text-align: center;
}

.preview-desc text {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.6;
}

