/* pages/user-center/user-center.wxss */

.container {
  min-height: 100vh;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
  padding: 0 0 40rpx 0;
  position: relative;
}

/* 顶部装饰 */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, rgba(255, 169, 77, 0.1) 0%, transparent 100%);
  pointer-events: none;
}

.header {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
  position: relative;
  z-index: 1;
}

.header-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 15rpx;
  filter: drop-shadow(0 4rpx 15rpx rgba(255, 169, 77, 0.5));
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.logo {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  display: block;
  text-shadow: 0 4rpx 15rpx rgba(255, 169, 77, 0.3);
  letter-spacing: 2rpx;
}

.subtitle {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  display: block;
  font-weight: 400;
}

/* 用户信息卡片 */
.user-info-card {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.12), rgba(204, 122, 61, 0.08));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.3);
  border-radius: 30rpx;
  padding: 40rpx;
  margin: 0 25rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
}

.user-info-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.15), transparent);
  border-radius: 50%;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffa94d, #cc7a3d);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  box-shadow: 0 8rpx 25rpx rgba(255, 169, 77, 0.4);
  position: relative;
  flex-shrink: 0;
}

.avatar-glow {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.3), transparent);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.avatar-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #0d1520;
  position: relative;
  z-index: 1;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}

.user-details {
  flex: 1;
  min-width: 0;
}

.user-email,
.user-nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 169, 77, 0.2);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 169, 77, 0.3);
}

.level-icon {
  font-size: 24rpx;
}

.user-level {
  font-size: 24rpx;
  color: #ffa94d;
  font-weight: 600;
}

/* 统计信息 */
.stats-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
  margin: 0 25rpx 30rpx;
}

.stat-card {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.2);
  border-radius: 20rpx;
  padding: 25rpx 15rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.stat-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 30rpx rgba(255, 169, 77, 0.2);
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  display: block;
  filter: drop-shadow(0 2rpx 8rpx rgba(255, 169, 77, 0.3));
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffa94d;
  margin-bottom: 8rpx;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(255, 169, 77, 0.4);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  font-weight: 500;
}

/* 快捷功能 */
.quick-actions {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.25);
  border-radius: 30rpx;
  padding: 35rpx 30rpx;
  margin: 0 25rpx 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffa94d;
  margin-bottom: 30rpx;
  text-shadow: 0 2rpx 10rpx rgba(255, 169, 77, 0.3);
}

.title-icon {
  font-size: 36rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(255, 169, 77, 0.4));
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 10rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  background: rgba(255, 169, 77, 0.1);
  transform: scale(0.95);
}

.action-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.action-icon-wrapper.memorials {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.3), rgba(204, 122, 61, 0.2));
  border: 2rpx solid rgba(255, 169, 77, 0.4);
}

.action-icon-wrapper.photos {
  background: linear-gradient(135deg, rgba(94, 114, 228, 0.3), rgba(74, 94, 208, 0.2));
  border: 2rpx solid rgba(94, 114, 228, 0.4);
}

.action-icon-wrapper.orders {
  background: linear-gradient(135deg, rgba(46, 213, 115, 0.3), rgba(26, 188, 95, 0.2));
  border: 2rpx solid rgba(46, 213, 115, 0.4);
}

.action-icon-wrapper.theme {
  background: linear-gradient(135deg, rgba(252, 92, 125, 0.3), rgba(232, 72, 105, 0.2));
  border: 2rpx solid rgba(252, 92, 125, 0.4);
}

.action-item:active .action-icon-wrapper {
  transform: scale(1.1);
}

.action-icon {
  font-size: 44rpx;
}

.action-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  text-align: center;
}

/* 功能权限 */
.permissions-section {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.25);
  border-radius: 30rpx;
  padding: 35rpx 30rpx;
  margin: 0 25rpx 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.permission-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.permission-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 25rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 169, 77, 0.15);
  transition: all 0.3s ease;
}

.permission-item:active {
  background: rgba(255, 255, 255, 0.08);
}

.permission-left {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.permission-icon {
  font-size: 32rpx;
  filter: drop-shadow(0 2rpx 5rpx rgba(255, 169, 77, 0.3));
}

.permission-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.permission-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.permission-status.enabled {
  color: #2ecc71;
  background: rgba(46, 204, 113, 0.15);
}

.permission-status.enabled .status-dot {
  background: #2ecc71;
  box-shadow: 0 0 10rpx rgba(46, 204, 113, 0.6);
}

.permission-status.disabled {
  color: #e74c3c;
  background: rgba(231, 76, 60, 0.15);
}

.permission-status.disabled .status-dot {
  background: #e74c3c;
}

/* 升级区域 */
.upgrade-section {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.15), rgba(204, 122, 61, 0.1));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.4);
  border-radius: 30rpx;
  padding: 45rpx 35rpx;
  margin: 0 25rpx 30rpx;
  text-align: center;
  box-shadow: 0 10rpx 40rpx rgba(255, 169, 77, 0.3);
  position: relative;
  overflow: hidden;
}

.upgrade-section::before {
  content: '';
  position: absolute;
  top: -100rpx;
  left: -100rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.2), transparent);
  border-radius: 50%;
}

.upgrade-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 15rpx rgba(255, 169, 77, 0.5));
  animation: float 3s ease-in-out infinite;
}

.upgrade-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffa94d;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 10rpx rgba(255, 169, 77, 0.4);
}

.upgrade-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 25rpx;
  display: block;
}

.upgrade-features {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.feature-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 8rpx 16rpx;
  background: rgba(255, 169, 77, 0.2);
  border-radius: 15rpx;
  border: 1rpx solid rgba(255, 169, 77, 0.3);
}

.upgrade-btn {
  background: linear-gradient(135deg, #ffa94d, #cc7a3d);
  color: #0d1520;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 50rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 169, 77, 0.5);
  transition: all 0.3s ease;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.upgrade-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 20rpx rgba(255, 169, 77, 0.6);
}

.btn-icon {
  font-size: 32rpx;
}

/* 退出登录 */
.logout-section {
  margin: 0 25rpx;
}

.btn-logout {
  width: 100%;
  background: rgba(231, 76, 60, 0.15);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(231, 76, 60, 0.3);
  border-radius: 25rpx;
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(231, 76, 60, 0.2);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-logout:active {
  background: rgba(231, 76, 60, 0.25);
  transform: scale(0.98);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .stats-section {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .action-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
