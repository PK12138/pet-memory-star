/* pages/user-center/user-center.wxss */

.container {
  min-height: 100vh;
  background: radial-gradient(ellipse at bottom, #0f1b2e 0%, #050b14 100%);
  padding: 0 0 40rpx 0;
  position: relative;
}

/* 顶部装饰 */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, rgba(255, 169, 77, 0.1) 0%, transparent 100%);
  pointer-events: none;
}

.header {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
  position: relative;
  z-index: 1;
}

.header-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 15rpx;
  filter: drop-shadow(0 4rpx 15rpx rgba(255, 169, 77, 0.5));
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.logo {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  display: block;
  text-shadow: 0 4rpx 15rpx rgba(255, 169, 77, 0.3);
  letter-spacing: 2rpx;
}

.subtitle {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  display: block;
  font-weight: 400;
}

/* 用户信息卡片 */
.user-info-card {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.12), rgba(204, 122, 61, 0.08));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.3);
  border-radius: 30rpx;
  padding: 40rpx;
  margin: 0 25rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
}

.user-info-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.15), transparent);
  border-radius: 50%;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffa94d, #cc7a3d);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  box-shadow: 0 8rpx 25rpx rgba(255, 169, 77, 0.4);
  position: relative;
  flex-shrink: 0;
}

.avatar-glow {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.3), transparent);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.avatar-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #0d1520;
  position: relative;
  z-index: 1;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}

.user-details {
  flex: 1;
  min-width: 0;
}

.user-email,
.user-nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 169, 77, 0.2);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 169, 77, 0.3);
}

.level-icon {
  font-size: 24rpx;
}

.user-level {
  font-size: 24rpx;
  color: #ffa94d;
  font-weight: 600;
}

/* 统计信息 */
.stats-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
  margin: 0 25rpx 30rpx;
}

.stat-card {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.2);
  border-radius: 20rpx;
  padding: 25rpx 15rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.stat-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 30rpx rgba(255, 169, 77, 0.2);
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  display: block;
  filter: drop-shadow(0 2rpx 8rpx rgba(255, 169, 77, 0.3));
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffa94d;
  margin-bottom: 8rpx;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(255, 169, 77, 0.4);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  font-weight: 500;
}

/* 快捷功能 */
.quick-actions {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.08), rgba(204, 122, 61, 0.05));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.25);
  border-radius: 30rpx;
  padding: 35rpx 30rpx;
  margin: 0 25rpx 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffa94d;
  margin-bottom: 30rpx;
  text-shadow: 0 2rpx 10rpx rgba(255, 169, 77, 0.3);
}

.title-icon {
  font-size: 36rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(255, 169, 77, 0.4));
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 10rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  background: rgba(255, 169, 77, 0.1);
  transform: scale(0.95);
}

.action-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.action-icon-wrapper.memorials {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.3), rgba(204, 122, 61, 0.2));
  border: 2rpx solid rgba(255, 169, 77, 0.4);
}

.action-icon-wrapper.photos {
  background: linear-gradient(135deg, rgba(94, 114, 228, 0.3), rgba(74, 94, 208, 0.2));
  border: 2rpx solid rgba(94, 114, 228, 0.4);
}

.action-icon-wrapper.orders {
  background: linear-gradient(135deg, rgba(46, 213, 115, 0.3), rgba(26, 188, 95, 0.2));
  border: 2rpx solid rgba(46, 213, 115, 0.4);
}

.action-icon-wrapper.theme {
  background: linear-gradient(135deg, rgba(252, 92, 125, 0.3), rgba(232, 72, 105, 0.2));
  border: 2rpx solid rgba(252, 92, 125, 0.4);
}

.action-item:active .action-icon-wrapper {
  transform: scale(1.1);
}

.action-icon {
  font-size: 44rpx;
}

.action-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  text-align: center;
}


/* 升级区域 */
.upgrade-section {
  background: linear-gradient(135deg, rgba(255, 169, 77, 0.15), rgba(204, 122, 61, 0.1));
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 2rpx solid rgba(255, 169, 77, 0.4);
  border-radius: 30rpx;
  padding: 45rpx 35rpx;
  margin: 0 25rpx 30rpx;
  text-align: center;
  box-shadow: 0 10rpx 40rpx rgba(255, 169, 77, 0.3);
  position: relative;
  overflow: hidden;
}

.upgrade-section::before {
  content: '';
  position: absolute;
  top: -100rpx;
  left: -100rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 169, 77, 0.2), transparent);
  border-radius: 50%;
}

.upgrade-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 15rpx rgba(255, 169, 77, 0.5));
  animation: float 3s ease-in-out infinite;
}

.upgrade-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffa94d;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 10rpx rgba(255, 169, 77, 0.4);
}

.upgrade-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 25rpx;
  display: block;
}

.upgrade-features {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.feature-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 8rpx 16rpx;
  background: rgba(255, 169, 77, 0.2);
  border-radius: 15rpx;
  border: 1rpx solid rgba(255, 169, 77, 0.3);
}

.upgrade-btn {
  background: linear-gradient(135deg, #ffa94d, #cc7a3d);
  color: #0d1520;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 50rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 169, 77, 0.5);
  transition: all 0.3s ease;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.upgrade-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 20rpx rgba(255, 169, 77, 0.6);
}

.btn-icon {
  font-size: 32rpx;
}

/* 退出登录 */
.logout-section {
  margin: 0 25rpx;
}

.btn-logout {
  width: 100%;
  background: rgba(231, 76, 60, 0.15);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(231, 76, 60, 0.3);
  border-radius: 25rpx;
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(231, 76, 60, 0.2);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-logout:active {
  background: rgba(231, 76, 60, 0.25);
  transform: scale(0.98);
}

/* 星币卡 */
.coins-card {
  background: linear-gradient(135deg, rgba(255, 227, 149, 0.13), rgba(255, 182, 53, 0.09));
  border-radius: 32rpx;
  margin: 35rpx 25rpx 24rpx 25rpx;
  box-shadow: 0 10rpx 40rpx #ffd66028, 0 2rpx 18rpx #ffeb9e2e;
  padding: 40rpx 34rpx 32rpx 34rpx;
  position: relative;
  overflow: visible;
  border: 2rpx solid rgba(255, 169, 77, 0.23);
  transition: box-shadow 0.2s;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}
.coins-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  position: relative;
}
.coins-left {
  display: flex;
  align-items: center;
  position: relative;
  gap: 16rpx;
}
.coins-main-icon-bg {
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  left: -17rpx;
  top: -17rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fffbe5 55%, transparent 100%);
  z-index: 0;
  filter: blur(2rpx);
  animation: halo-pulse 2.6s infinite alternate;
  opacity: 0.7;
}
.coins-icon {
  font-size: 50rpx;
  position: relative;
  z-index: 2;
  text-shadow: 0 0 14rpx #ffecc1, 0 4rpx 16rpx #ffe099b2;
  margin-right: 10rpx;
  animation: bounce 2.5s ease-in-out infinite;
}
.coins-icon.glow { filter: drop-shadow(0 0 12rpx #ffe099bb); }
@keyframes halo-pulse {
  0%,100% { transform: scale(1); opacity: 0.6; }
  60% { transform: scale(1.21); opacity: 1; }
}
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  45% { transform: translateY(-7rpx) scale(1.13); }
  60% { transform: translateY(2rpx) scale(1.02); }
}
.coins-info {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}
.coins-label {
  font-size: 26rpx;
  color: #ffc74d;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx #ffbe80b0;
  margin-bottom: 4rpx;
}
.coins-balance {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffd031;
  letter-spacing: 2rpx;
  text-shadow: 0 0 9rpx #ffeead, 0 2rpx 8rpx #ffd36699, 0 -2rpx 7rpx #fff9c233;
  border-radius: 14rpx;
  padding: 3rpx 16rpx 3rpx 16rpx;
  background: linear-gradient(90deg,#ffeabf70 60%,#fff9e7a8 100%);
  box-shadow: 0 0 22rpx #fff7c4a9, 0 2rpx 14rpx #ffd05344 inset;
  display:inline-block;
  border: 1rpx dashed #ffd17a74;
  margin-bottom: 1rpx;
  transition: color 0.24s, box-shadow 0.21s;
}
.coins-balance.fancy {
  animation: goldGlow 2.3s linear infinite alternate;
}
@keyframes goldGlow {
  from { color:#ffd031; box-shadow: 0 0 22rpx #ffda8a99, 0 2rpx 14rpx #fff3a6 inset; }
  to { color:#ffe179; box-shadow: 0 0 32rpx #ffe69bfa, 0 2rpx 14rpx #fff7c377 inset; }
}
.coins-arrow {
  font-size: 38rpx;
  margin-left: 12rpx;
  color: #ffdc89c7;
  text-shadow: 0 2rpx 8rpx #ffd97c77;
  padding-top: 8rpx;
  font-weight: 600;
}
.coins-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 15rpx;
  gap: 30rpx;
}
.coins-btn {
  display: flex;
  align-items: center;
  gap: 11rpx;
  padding: 18rpx 32rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff6e4;
  background: linear-gradient(114deg,#ffd286 40%,#ffb62c 120%);
  box-shadow: 0 2rpx 16rpx #ffce72a1;
  border: 1.2rpx solid #ffe7c2;
  transition: background 0.23s, transform 0.11s;
  cursor: pointer;
  position: relative;
  z-index: 1;
}
.coins-btn.neon {
  animation: coinsGlow 1.8s infinite alternate;
}
@keyframes coinsGlow {
  from {
    box-shadow: 0 0 15rpx #ffeabf88, 0 2rpx 7rpx #ffd14866 inset;
  }
  to {
    box-shadow: 0 0 32rpx #ffe066d0, 0 2rpx 12rpx #fffbe945 inset;
  }
}
.coins-btn:active {
  background: linear-gradient(90deg,#ffe8af 40%,#ffc33f 120%);
  color:#be8106;
  transform: scale(0.96);
}
.btn-icon {
  font-size: 30rpx;
}
.btn-text {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .stats-section {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .action-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.coins-btn.disabled-btn,
.upgrade-btn.disabled-btn {
  background: linear-gradient(90deg, #f9e7d8 10%, #dadada 100%);
  color: #baa;
  border-color: #e2d6cf;
  box-shadow: none;
  opacity: 0.7;
  pointer-events: none;
}
.disabled-section {
  opacity:0.7;
  filter: grayscale(0.25);
}
.ad-placeholder {
  width: 100%;
  text-align: center;
  margin: 22rpx 0 0 0;
  padding: 22rpx 0 22rpx 0;
  border-radius: 22rpx;
  border: 2rpx dashed #ffe6aa77;
  color: #ceb165;
  background: rgba(255,243,211,0.11);
  font-size: 28rpx;
  letter-spacing:1.2rpx;
  font-weight:600;
  box-shadow: 0 2rpx 12rpx #eee8c72a;
  opacity: 0.93;
}
